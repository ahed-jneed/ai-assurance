# Prettier also honours .gitignore. These entries cover files that are tracked
# (or ignored only by the repository-root .gitignore) but must not be reformatted.

# Generated output, lockfiles and checkout-local tool state
dist/
coverage/
.openai/
package-lock.json

# Copies and vendored sources kept byte-identical with their upstream
vendor/
public/
drizzle/meta/
# shadcn registry files vendored (nearly) verbatim (see eslint.config.mjs)
components/ui/
hooks/use-mobile.ts

# Byte-for-byte copies of ../templates and ../docs data (scripts/sync-generated.mjs)
lib/*.json

# Markdown is outside the formatting baseline
*.md

# Generated criteria bundle (scripts/sync-generated.mjs), serialised in JCS order
lib/criteria/*.json

{
  "name": "ai-assurance-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/wrangler-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "sync": "node scripts/sync-generated.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:sync": "node scripts/sync-generated.mjs --check",
    "check:build": "node scripts/strict-build.mjs",
    "check:harnesses": "node scripts/run-checks.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "self-host": "node scripts/self-host.mjs",
    "db:migrate:local": "node scripts/db-migrate-local.mjs",
    "test:e2e": "playwright test",
    "check:fixtures": "node ../schemas/validate-run-schema.mjs --fixtures .test-output/run-schema-fixtures.json --external-run ../tmp/assurance-worker-fixture/hosted-external-run.json --external-run ../tmp/assurance-worker-fixture/hosted-external-run-1.5.json --external-run ../tmp/assurance-worker-fixture/hosted-external-run-client-local.json &&node ../schemas/validate-procedure-schema.mjs .test-output/execution-schema-fixture.json && node ../schemas/validate-working-paper-schema.mjs --documents .test-output/dossier-papers.json",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run check:sync && npm run check:build && npm run check:harnesses && npm run check:fixtures",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/workers-types": "5.20261115.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "json-rpc-2.0": "1.7.1",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.4.5",
    "vite": "8.3.8",
    "vitest": "5.0.5",
    "wrangler": "4.160.0"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    },
    "satori": {
      "fflate": "0.7.5"
    }
  }
}

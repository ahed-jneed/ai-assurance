{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-assurance:working-paper:2.1",
  "title": "AI Assurance working paper or memo revision",
  "description": "Single working-paper contract with two distinct artifacts: a catalog working-paper or memo revision (paperRevision) and an engine-generated diagnostic draft (generatedDraft). Schema validity does not establish reviewer independence, tenant access, evidence truthfulness or legal sufficiency; the workflow service enforces those.",
  "oneOf": [
    {
      "$ref": "#/$defs/paperRevision"
    },
    {
      "$ref": "#/$defs/generatedDraft"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "paperRevision": {
      "title": "Catalog working-paper or memo revision",
      "description": "A revision of a templates/catalog.json item. Drafts may leave narrative fields empty; submitted, reviewed, approved and sealed revisions require procedures, an evaluation rationale, approvals and, once sealed, two approvals and a content digest. schemaVersion 1.1.0 is what the application exports (site-app/lib/papers/): it adds the item kind, the narrative sections the paper is written in and, for memos, the structured decision records the memo rests on. templates/working-paper.blank.json is a draft specimen.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "tenantId",
        "clientId",
        "engagementId",
        "catalogId",
        "templateVersion",
        "revision",
        "status",
        "stage",
        "title",
        "scope",
        "applicability",
        "riskReferences",
        "procedures",
        "evidence",
        "runReferences",
        "evaluation",
        "reviewComments",
        "approvals",
        "provenance"
      ],
      "properties": {
        "schemaVersion": {
          "enum": [
            "1.0.0",
            "1.1.0"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "engagementId": {
          "type": "string",
          "minLength": 1
        },
        "catalogId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "working_paper",
            "memo"
          ],
          "description": "The catalog item kind."
        },
        "templateVersion": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "draft",
            "in_progress",
            "submitted",
            "returned",
            "reviewed",
            "approved",
            "sealed",
            "superseded"
          ]
        },
        "stage": {
          "enum": [
            "Planning",
            "Fieldwork",
            "Evidence Evaluation",
            "Reporting",
            "Sign-off",
            "Remediation and Monitoring"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "enum": [
            "internal",
            "client"
          ],
          "description": "Who a signed paper is written for; released client reports publish client papers only."
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "riskReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "procedures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/procedure"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "runReferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "evaluation": {
          "$ref": "#/$defs/evaluation"
        },
        "reviewComments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comment"
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/approval"
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "createdBy",
            "createdAt",
            "contentOrigin",
            "supersedesId",
            "amendmentReason"
          ],
          "properties": {
            "createdBy": {
              "type": "string",
              "minLength": 1
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "contentOrigin": {
              "enum": [
                "human",
                "automation_draft",
                "import",
                "hybrid"
              ]
            },
            "supersedesId": {
              "type": [
                "string",
                "null"
              ]
            },
            "amendmentReason": {
              "type": [
                "string",
                "null"
              ]
            },
            "contentDigest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "narrative": {
          "$ref": "#/$defs/narrative"
        },
        "records": {
          "$ref": "#/$defs/memoRecords"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "submitted",
                  "reviewed",
                  "approved",
                  "sealed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "procedures": {
                "minItems": 1
              },
              "evaluation": {
                "properties": {
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "evidenceSufficiency": {
                    "enum": [
                      "sufficient",
                      "insufficient",
                      "limited"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "reviewed",
                  "approved",
                  "sealed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "approvals": {
                "minItems": 1
              },
              "evaluation": {
                "properties": {
                  "auditorConclusion": {
                    "enum": [
                      "supported",
                      "qualified",
                      "deficiency",
                      "unable_to_conclude",
                      "not_applicable"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "sealed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "approvals": {
                "minItems": 2
              },
              "provenance": {
                "required": [
                  "contentDigest"
                ],
                "properties": {
                  "contentDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schemaVersion": {
                "const": "1.1.0"
              }
            },
            "required": [
              "schemaVersion"
            ]
          },
          "then": {
            "required": [
              "kind",
              "narrative"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "working_paper"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "records"
              ]
            }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systemId",
        "modelVersionIds",
        "periodStart",
        "periodEnd",
        "rulePackId",
        "operatorRoles",
        "criteria",
        "boundary",
        "exclusions"
      ],
      "properties": {
        "systemId": {
          "type": "string",
          "minLength": 1
        },
        "modelVersionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "periodStart": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "periodEnd": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "rulePackId": {
          "type": "string",
          "minLength": 1
        },
        "operatorRoles": {
          "type": "array",
          "items": {
            "enum": [
              "provider",
              "deployer",
              "importer",
              "distributor",
              "authorised_representative",
              "other"
            ]
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "boundary": {
          "type": "string"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "rationale",
        "regulatoryReferences",
        "sourceVersion",
        "approvedBy",
        "approvedAt"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "applicable",
            "not_applicable",
            "readiness"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "regulatoryReferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1
        },
        "approvedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "mode",
        "criterion",
        "diagnosticState",
        "observation",
        "sample",
        "evidenceVersionIds",
        "runIds",
        "findingIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "manual",
            "automated",
            "hybrid"
          ]
        },
        "criterion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "metric",
            "operator",
            "threshold",
            "justification",
            "policyVersion",
            "approvedBy"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "metric": {
              "type": [
                "string",
                "null"
              ]
            },
            "operator": {
              "enum": [
                "gte",
                "lte",
                "between",
                "eq",
                "manual",
                null
              ]
            },
            "threshold": {
              "type": [
                "number",
                "array",
                "null"
              ],
              "items": {
                "type": "number"
              }
            },
            "justification": {
              "type": "string"
            },
            "policyVersion": {
              "type": [
                "string",
                "null"
              ]
            },
            "approvedBy": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "diagnosticState": {
          "enum": [
            "pending",
            "pass",
            "attention",
            "fail",
            "inconclusive",
            "not_run",
            "error"
          ]
        },
        "observation": {
          "type": "string"
        },
        "sample": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "population",
            "unit",
            "method",
            "size",
            "rationale",
            "selectedIds",
            "seed",
            "limits"
          ],
          "properties": {
            "population": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "enum": [
                "complete_population",
                "random",
                "stratified",
                "systematic",
                "judgmental",
                "other"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "rationale": {
              "type": "string"
            },
            "selectedIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "seed": {
              "type": [
                "integer",
                "null"
              ]
            },
            "limits": {
              "type": "string"
            }
          }
        },
        "evidenceVersionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "findingIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactVersionId",
        "sha256",
        "source",
        "custodian",
        "period",
        "systemVersion",
        "assertions",
        "reliability",
        "completeness",
        "limitations"
      ],
      "properties": {
        "artifactVersionId": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "custodian": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string"
        },
        "systemVersion": {
          "type": "string"
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reliability": {
          "type": "string"
        },
        "completeness": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "manifestArtifactVersionId",
        "manifestDigest",
        "testSuiteVersion",
        "environmentDigest",
        "inputArtifactVersionIds",
        "policyVersion",
        "seed",
        "warnings"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "manifestArtifactVersionId": {
          "type": "string",
          "minLength": 1
        },
        "manifestDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "SHA-256 of the frozen run manifest; null for runs made before manifests were frozen."
        },
        "testSuiteVersion": {
          "type": "string",
          "minLength": 1
        },
        "environmentDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "SHA-256 of the execution environment; null where the runner records none (the hosted runner records its runner version only)."
        },
        "inputArtifactVersionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceSufficiency",
        "contradictions",
        "limitations",
        "auditorConclusion",
        "rationale",
        "findingIds",
        "managementResponseId",
        "subsequentEventsThrough"
      ],
      "properties": {
        "evidenceSufficiency": {
          "enum": [
            "not_assessed",
            "sufficient",
            "insufficient",
            "limited"
          ]
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auditorConclusion": {
          "enum": [
            "not_assessed",
            "supported",
            "qualified",
            "deficiency",
            "unable_to_conclude",
            "not_applicable"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "findingIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "managementResponseId": {
          "type": [
            "string",
            "null"
          ]
        },
        "subsequentEventsThrough": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "reviewerId",
        "severity",
        "text",
        "state",
        "response",
        "resolvedBy",
        "resolution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "reviewerId": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "blocking",
            "nonblocking"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "open",
            "responded",
            "resolved",
            "reopened"
          ]
        },
        "response": {
          "type": "string"
        },
        "resolvedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution": {
          "type": "string"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actorId",
        "role",
        "decision",
        "revision",
        "contentDigest",
        "approvedAt",
        "signatureReference"
      ],
      "properties": {
        "actorId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "preparer",
            "reviewer",
            "lead_auditor",
            "engagement_quality_reviewer"
          ]
        },
        "decision": {
          "enum": [
            "approve",
            "return"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "signatureReference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generatedDraft": {
      "title": "Engine-generated diagnostic draft",
      "description": "Draft working paper that engine/diagnostics.py derives from one diagnostic result. It is supporting evidence, always requires human review, carries no sign-offs and cannot satisfy report issuance gates.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "engagementId",
        "modelId",
        "runId",
        "templateId",
        "title",
        "status",
        "objective",
        "regulatoryMapping",
        "procedure",
        "evidence",
        "exceptions",
        "proposedConclusion",
        "review",
        "version"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "engagementId": {
          "$ref": "#/$defs/id"
        },
        "modelId": {
          "$ref": "#/$defs/id"
        },
        "runId": {
          "$ref": "#/$defs/id"
        },
        "templateId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "draft"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "regulatoryMapping": {
          "type": "object",
          "required": [
            "regulation",
            "articleReferences",
            "mappingKind"
          ],
          "properties": {
            "regulation": {
              "type": "string"
            },
            "articleReferences": {
              "type": "string"
            },
            "mappingKind": {
              "type": "string"
            }
          }
        },
        "procedure": {
          "type": "object",
          "required": [
            "testId",
            "runnerVersion",
            "configurationSha256"
          ],
          "properties": {
            "testId": {
              "$ref": "#/$defs/id"
            },
            "runnerVersion": {
              "type": "string"
            },
            "configurationSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "evidence": {
          "type": "object",
          "required": [
            "inputHashes",
            "metrics"
          ],
          "properties": {
            "inputHashes": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/sha256"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "value",
                  "unit",
                  "sampleSize"
                ]
              }
            }
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proposedConclusion": {
          "enum": [
            "pass",
            "fail",
            "inconclusive",
            "not_applicable"
          ]
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "preparerId",
            "reviewerId",
            "reviewedAt",
            "signOffs"
          ],
          "properties": {
            "required": {

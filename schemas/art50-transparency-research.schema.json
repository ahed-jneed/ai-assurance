{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-assurance:art50-transparency-research:1.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "title",
    "schemaDoc",
    "issue",
    "intendedConsumers",
    "researchedOn",
    "basedOn",
    "approval",
    "notLegalAdvice",
    "vocabularies",
    "sources",
    "guidance",
    "codeOfPractice",
    "obligations",
    "timeline",
    "procedures",
    "evidenceItems",
    "sampling",
    "standards",
    "consistencyChecks",
    "repositoryChanges",
    "legalReviewItems",
    "unverified"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "kind": {
      "const": "art50-transparency-research"
    },
    "id": {
      "const": "art50-transparency-2026-11"
    },
    "researchedOn": {
      "$ref": "#/$defs/date"
    },
    "intendedConsumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "basedOn": {
      "type": "object",
      "required": [
        "id",
        "file",
        "entryIds",
        "guidanceIds",
        "legalReviewIds",
        "unverifiedIds"
      ],
      "properties": {
        "id": {
          "const": "rule-pack-2026-11"
        },
        "entryIds": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "status",
        "reviewer",
        "approvedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "unapproved",
            "approved"
          ]
        }
      }
    },
    "vocabularies": {
      "type": "object",
      "required": [
        "verificationStatus",
        "actor",
        "testMethod",
        "outcome",
        "conclusion",
        "factVocabulary",
        "predicateOperators",
        "predicateRule",
        "exclusionRule",
        "derivationRule",
        "stepConditionRule",
        "statisticsRule",
        "roleRequired"
      ],
      "properties": {
        "factVocabulary": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/fact"
          }
        },
        "testMethod": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/method"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "guidance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/guidance"
      }
    },
    "codeOfPractice": {
      "$ref": "#/$defs/codeOfPractice"
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/timelineEntry"
      }
    },
    "procedures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/procedure"
      }
    },
    "evidenceItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "sampling": {
      "$ref": "#/$defs/sampling"
    },
    "standards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/standard"
      }
    },
    "consistencyChecks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/consistencyCheck"
      }
    },
    "repositoryChanges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repositoryChange"
      }
    },
    "legalReviewItems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legalReviewItem"
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unverifiedItem"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "verifiedOn"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "secondary_only"
          ]
        },
        "verifiedOn": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "legalReview": {
      "type": "object",
      "required": [
        "required",
        "itemIds"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "itemIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^LR-(A50-)?[0-9]{2}$"
          }
        }
      },
      "if": {
        "properties": {
          "required": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "itemIds": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "itemIds": {
            "maxItems": 0
          }
        }
      }
    },
    "actor": {
      "enum": [
        "provider",
        "deployer",
        "gpai_model_provider",
        "commission",
        "ai_board",
        "ai_office",
        "member_state"
      ]
    },
    "method": {
      "enum": [
        "inquiry",
        "inspection",
        "observation",
        "reperformance",
        "recomputation",
        "analytical_review"
      ]
    },
    "predicate": {
      "type": "object",
      "required": [
        "fact",
        "op",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "fact": {
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "in",
            "before",
            "onOrAfter"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "string",
            "array"
          ]
        }
      }
    },
    "predicates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/predicate"
      }
    },
    "nonEmptyPredicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/predicate"
      }
    },
    "sourceRef": {
      "type": "object",
      "required": [
        "sourceId",
        "pinpoint"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "pinpoint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "publisher",
        "kind",
        "retrievedOn"
      ],
      "anyOf": [
        {
          "required": [
            "accessUrl"
          ]
        },
        {
          "required": [
            "canonicalUrl"
          ]
        }
      ],
      "properties": {
        "kind": {
          "enum": [
            "official_journal",
            "consolidated_text",
            "commission",
            "ai_board",
            "commission_study",
            "specification_body",
            "standards_body",
            "web_archive",
            "repository",
            "secondary"
          ]
        },
        "retrievedOn": {
          "$ref": "#/$defs/date"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "guidance": {
      "type": "object",
      "required": [
        "id",
        "title",
        "reference",
        "status",
        "legalEffect",
        "dates",
        "sourceIds",
        "verification"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "approved_content",
            "adopted",
            "published",
            "assessed_adequate"
          ]
        },
        "dates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "event",
              "date"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        "sourceIds": {
          "$ref": "#/$defs/ids"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "type",
        "definition",
        "definedIn",
        "sourceIds"
      ],
      "properties": {
        "type": {
          "enum": [
            "boolean_or_unknown",
            "date_or_unknown"
          ]
        },
        "definedIn": {
          "enum": [
            "rule-pack-2026-11",
            "art50-transparency-2026-11"
          ]
        },
        "derivation": {
          "type": "object",
          "required": [
            "anyOf"
          ],
          "properties": {
            "anyOf": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "legalReviewItemIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^LR-(A50-)?[0-9]{2}$"
          }
        },
        "sourceIds": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "measure": {
      "type": "object",
      "required": [
        "id",
        "section",
        "commitment",
        "title",
        "status",
        "summary",
        "articleRefs",
        "sourceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^COP-S[12]-"
        },
        "section": {
          "enum": [
            1,
            2
          ]
        },
        "commitment": {
          "enum": [
            1,
            2,
            3,
            4
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 80
        },
        "status": {
          "enum": [
            "mandatory",
            "optional"
          ]
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "codeOfPractice": {
      "type": "object",
      "required": [
        "id",
        "title",
        "guidanceIds",
        "sections",
        "termsRule",
        "signatoryEffect",
        "measures",
        "parameters",
        "sourceIds",
        "verification"
      ],
      "properties": {
        "measures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/measure"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "value",
              "unit",
              "sourceRefs"
            ],
            "properties": {
              "sourceRefs": {
                "$ref": "#/$defs/sourceRefs"
              }
            }
          }
        },
        "sourceIds": {
          "$ref": "#/$defs/ids"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "exclusion": {
      "type": "object",
      "required": [
        "id",
        "label",
        "basis",
        "ifAll",
        "sourceRefs",
        "legalReview"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EX-"
        },
        "basis": {
          "enum": [
            "statutory",
            "guidance",
            "code_of_practice"
          ]
        },
        "ifAll": {
          "$ref": "#/$defs/nonEmptyPredicates"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "legalReview": {
          "$ref": "#/$defs/legalReview"
        }
      },
      "if": {
        "properties": {
          "basis": {
            "const": "guidance"
          }
        }
      },
      "then": {
        "properties": {
          "legalReview": {
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "required": [
        "appliesFrom",
        "ruleEntryId",
        "transitional"
      ],
      "properties": {
        "appliesFrom": {
          "$ref": "#/$defs/date"
        },
        "transitional": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ruleEntryId",
              "deadline",
              "appliesIf"
            ],
            "properties": {
              "deadline": {
                "$ref": "#/$defs/date"
              },
              "appliesIf": {
                "$ref": "#/$defs/nonEmptyPredicates"
              }
            }
          }
        }
      }
    },
    "applicability": {
      "type": "object",
      "required": [
        "roleRequired",
        "appliesIf",
        "exclusions",
        "timing"
      ],
      "properties": {
        "roleRequired": {
          "enum": [
            "provider",
            "deployer",
            "provider_or_deployer"
          ]
        },
        "appliesIf": {
          "$ref": "#/$defs/predicates"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exclusion"
          }
        },
        "timing": {
          "$ref": "#/$defs/timing"
        }
      }
    },
    "testStep": {
      "type": "object",
      "required": [
        "id",
        "description",
        "method",
        "evidenceItemIds",
        "sourceRefs",
        "samplingRuleId",
        "codeMeasureIds",
        "automatable"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A50-P-[0-9]{2}[A-F]?-S[0-9]{2}$"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "evidenceItemIds": {
          "$ref": "#/$defs/ids"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "samplingRuleId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^SR-A50-[0-9]{2}$"
        },
        "codeMeasureIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^COP-S[12]-"
          }
        },
        "onlyIf": {
          "$ref": "#/$defs/nonEmptyPredicates"
        },
        "automatable": {
          "type": "boolean"
        }
      }
    },
    "criterion": {
      "type": "object",
      "required": [
        "id",
        "metric",
        "band",
        "bandBasis",
        "members",
        "role",
        "libraryEntry",
        "minimumN"
      ],
      "properties": {
        "band": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "lower": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "upper": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                }
              }
            }
          ]
        },
        "bandBasis": {
          "enum": [
            "methodology_default",
            "provider_declared",
            "provider_declared_else_default",
            "descriptive"
          ]
        },
        "role": {
          "enum": [
            "confirmatory",
            "exploratory",
            "descriptive"
          ]
        },
        "minimumN": {
          "type": "integer",
          "minimum": 30
        },
        "id": {
          "type": "string",
          "pattern": "^A50-P-[0-9]{2}[A-F]?-C[0-9]{2}$"
        },
        "metric": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "members": {
          "type": "string",
          "minLength": 1
        },
        "libraryEntry": {
          "description": "The threshold-library entry (schemas/threshold-library.json) that holds the band, with the parameter values that give the band shown; null for a descriptive criterion.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "id",
                "version",
                "parameters"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^policy\\.eu-aia\\.art50-[a-z-]+$"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "parameters": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "number"
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "procedure": {
      "type": "object",
      "required": [
        "id",
        "title",
        "obligationIds",
        "articleRefs",
        "actor",
        "catalogItemId",
        "applicability",
        "objective",
        "testSteps",
        "criteria",
        "passCriteria",
        "failCriteria",
        "inconclusiveCriteria",
        "sourceIds",
        "verification",
        "legalReview"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A50-P-[0-9]{2}[A-F]?$"
        },
        "obligationIds": {
          "$ref": "#/$defs/ids"
        },
        "actor": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/actor"
          }
        },
        "catalogItemId": {
          "type": "string",
          "pattern": "^(WP|MEM)-[A-Z0-9]+-[0-9]{2}$"
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "testSteps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/testStep"
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "passCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "failCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "inconclusiveCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "sourceIds": {
          "$ref": "#/$defs/ids"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "legalReview": {
          "$ref": "#/$defs/legalReview"
        }
      }
    },
    "obligation": {
      "type": "object",
      "required": [
        "id",
        "articleRef",
        "actor",
        "summary",
        "exceptionIds",
        "appliesFrom",
        "ruleEntryId",
        "codeOfPractice",
        "procedureIds",
        "sourceIds",
        "verification",
        "legalReview"
      ],
      "properties": {
        "actor": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/actor"
          }
        },
        "appliesFrom": {
          "$ref": "#/$defs/date"
        },
        "procedureIds": {
          "$ref": "#/$defs/ids"
        },
        "sourceIds": {
          "$ref": "#/$defs/ids"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "legalReview": {
          "$ref": "#/$defs/legalReview"
        }
      }
    },
    "timelineEntry": {
      "type": "object",
      "required": [
        "id",
        "date",
        "kind",
        "event",
        "sourceIds",
        "verification"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "kind": {
          "enum": [
            "legal",
            "guidance",
            "code_milestone"
          ]
        },
        "sourceIds": {
          "$ref": "#/$defs/ids"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "origin",
        "usedBy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EV-A50-[0-9]{2}$"
        },
        "usedBy": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "sampling": {
      "type": "object",
      "required": [
        "method",
        "methodologyDefaults",
        "caveat",
        "rules",
        "zeroFailureTable",
        "powerTable",
        "conclusionRule",
        "sourceIds"
      ],
      "properties": {
        "methodologyDefaults": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "metric",
              "band",
              "range",
              "legalStatus",
              "rationale"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^MD-A50-[0-9]{2}$"
              },
              "band": {
                "oneOf": [
                  {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "properties": {
                      "lower": {
                        "type": "number"
                      },
                      "upper": {
                        "type": "number"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "bound",
                      "derivation",
                      "tolerance",
                      "defaultIfUndeclared"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "bound": {
                        "enum": [
                          "lower",
                          "upper"
                        ]
                      },
                      "derivation": {
                        "enum": [
                          "declared_minus_tolerance",
                          "declared_plus_tolerance"
                        ]
                      },
                      "tolerance": {
                        "type": "number",
                        "minimum": 0
                      },
                      "defaultIfUndeclared": {
                        "type": "number",

{
  "$comment": [
    "Hand-maintained input of .build-run-schema.py, which generates test-run.schema.json from this file, its own definitions and .extend-assurance-schema.py.",
    "legacyRun is the 1.0 run body and $defs holds the shared definitions that the scripts do not build. Edit them here, then run python schemas/.build-run-schema.py (or npm run sync in site-app/).",
    "A null member is a placeholder that the generator fills; it only fixes the member order of the generated schema."
  ],
  "legacyRun": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "contractVersion",
      "id",
      "engagementId",
      "modelId",
      "datasetId",
      "suite",
      "thresholds",
      "seed",
      "state",
      "outcome",
      "provenance",
      "paperIds"
    ],
    "properties": {
      "contractVersion": {
        "const": "1.0"
      },
      "id": {
        "$ref": "#/$defs/id"
      },
      "tenantId": {
        "$ref": "#/$defs/id"
      },
      "engagementId": {
        "$ref": "#/$defs/id"
      },
      "systemVersionId": {
        "$ref": "#/$defs/id"
      },
      "modelId": {
        "$ref": "#/$defs/id"
      },
      "datasetId": {
        "$ref": "#/$defs/id"
      },
      "referenceDatasetId": {
        "$ref": "#/$defs/id"
      },
      "idempotencyKey": {
        "type": "string",
        "minLength": 16,
        "maxLength": 128
      },
      "requestedBy": {
        "$ref": "#/$defs/id"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "startedAt": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "completedAt": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "suite": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "thresholds": {
        "anyOf": [
          {
            "$ref": "#/$defs/engineThresholds"
          },
          {
            "$ref": "#/$defs/productionThresholds"
          },
          {
            "$ref": "#/$defs/interactiveThresholds"
          }
        ]
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      },
      "sampling": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "populationSize",
          "sampleSize",
          "splitPolicy",
          "manifestHash"
        ],
        "properties": {
          "method": {
            "enum": [
              "full_population",
              "random",
              "stratified",
              "grouped",
              "time_window",
              "judgmental"
            ]
          },
          "populationSize": {
            "type": "integer",
            "minimum": 1
          },
          "sampleSize": {
            "type": "integer",
            "minimum": 1
          },
          "splitPolicy": {
            "enum": [
              "fixed_holdout",
              "stratified_cv",
              "group_cv",
              "time_series_cv",
              "no_training"
            ]
          },
          "manifestHash": {
            "$ref": "#/$defs/sha256"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "referenceWindow": {
            "$ref": "#/$defs/window"
          },
          "currentWindow": {
            "$ref": "#/$defs/window"
          }
        }
      },
      "state": {
        "enum": [
          "queued",
          "validating",
          "running",
          "cancelling",
          "cancelled",
          "succeeded",
          "failed"
        ]
      },
      "outcome": {
        "enum": [
          null,
          "pass",
          "fail",
          "inconclusive",
          "not_applicable"
        ]
      },
      "metrics": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/productionMetric"
        }
      },
      "provenance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inputHashes",
          "runnerVersion"
        ],
        "properties": {
          "inputHashes": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": "Actual consumed artifacts only. Saved-prediction runner hashes data/reference; it must not invent a model hash."
          },
          "runnerVersion": {
            "type": "string",
            "minLength": 1
          },
          "runnerImageDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "adapterVersion": {
            "type": "string",
            "minLength": 1
          },
          "dependencyLockHash": {
            "$ref": "#/$defs/sha256"
          },
          "codeCommit": {
            "type": "string",
            "minLength": 7
          },
          "executionMode": {
            "enum": [
              "demonstration",
              "isolated_worker",
              "manual_evidence"
            ]
          },
          "attemptId": {
            "$ref": "#/$defs/id"
          },
          "fencingToken": {
            "type": "integer",
            "minimum": 1
          },
          "outputArtifacts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/artifact"
            }
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "configSha256": {
            "$ref": "#/$defs/sha256"
          },
          "inputs": null,
          "determinism": {
            "type": "string"
          },
          "dependencies": null,
          "policyVersion": {
            "type": "string"
          },
          "runtime": null,
          "testDefinitionVersions": null
        }
      },
      "paperIds": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/id"
        },
        "uniqueItems": true
      },
      "limitations": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "error": {
        "anyOf": [
          {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "string"
          }
        ]
      },
      "diagnosticDisclaimer": {
        "type": "string"
      },
      "suiteDefinitions": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/suiteDefinition"
        }
      },
      "results": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/result"
        }
      },
      "overallOutcome": {
        "enum": [
          "pass",
          "fail",
          "inconclusive",
          "not_applicable"
        ]
      },
      "configuration": null,
      "config": null,
      "workingPapers": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "schemaVersion",
            "id",
            "engagementId",
            "status",
            "objective",
            "evidence",
            "review"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.0"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "engagementId": {
              "$ref": "#/$defs/id"
            },
            "status": {
              "const": "draft"
            },
            "review": {
              "type": "object",
              "required": [
                "required"
              ],
              "properties": {
                "required": {
                  "const": true
                }
              }
            }
          }
        }
      },
      "generatedWorkingPapers": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "schemaVersion",
            "id",
            "engagementId",
            "status",
            "objective",
            "evidence",
            "review"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.0"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "engagementId": {
              "$ref": "#/$defs/id"
            },
            "status": {
              "const": "draft"
            },
            "review": {
              "type": "object",
              "required": [
                "required"
              ],
              "properties": {
                "required": {
                  "const": true
                }
              }
            }
          }
        }
      },
      "reportSha256": {
        "$ref": "#/$defs/sha256"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "state": {
              "enum": [
                "queued",
                "validating",
                "running",
                "cancelling"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "outcome": {
              "const": null
            },
            "completedAt": {
              "const": null
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "state": {
              "enum": [
                "cancelled",
                "failed"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "outcome": {
              "const": "inconclusive"
            }
          },
          "required": [
            "completedAt"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "state": {
              "const": "succeeded"
            }
          }
        },
        "then": {
          "properties": {
            "outcome": {
              "enum": [
                "pass",
                "fail",
                "inconclusive",
                "not_applicable"
              ]
            }
          },
          "required": [
            "results",
            "completedAt"
          ]
        }
      }
    ]
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "objectVersion": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit",
        "sampleSize"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "sampleSize": {
          "type": "integer",
          "minimum": 0
        },
        "numerator": {
          "type": [
            "number",
            "null"
          ]
        },
        "denominator": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/thresholdRule"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidenceInterval": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "lower",
            "upper",
            "level",
            "method"
          ],
          "properties": {
            "lower": {
              "type": "number"
            },
            "upper": {
              "type": "number"
            },
            "level": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "slices": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "details": {},
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "inconclusive",
            "not_applicable"
          ]
        },
        "pValue": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "suiteDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testId",
        "testVersion",
        "parameters",
        "applicability"
      ],
      "properties": {
        "testId": {
          "$ref": "#/$defs/id"
        },
        "testVersion": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "enum": [
            "fairness",
            "explainability",
            "drift",
            "performance",
            "robustness",
            "data_quality",
            "logging",
            "security",
            "manual"
          ]
        },
        "parameters": {
          "type": "object",
          "description": "Validated against the selected test registry schema; cannot contain arbitrary executable code or SQL."
        },
        "applicability": {
          "enum": [
            "applicable",
            "not_applicable",
            "needs_information"
          ]
        },
        "applicabilityReason": {
          "type": "string"
        },
        "controlIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "resourceBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpuSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "memoryMiB": {
              "type": "integer",
              "minimum": 64
            },
            "maxRows": {
              "type": "integer",
              "minimum": 1
            },
            "maxOutputMiB": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "enum": [
                  "not_applicable",
                  "needs_information"
                ]
              }
            }
          },
          "then": {
            "required": [
              "applicabilityReason"
            ],
            "properties": {
              "applicabilityReason": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "productionThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "frozenAt",
        "approvedBy",
        "policyHash",
        "rules"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "frozenAt": {
          "type": "string",
          "format": "date-time"
        },
        "approvedBy": {
          "$ref": "#/$defs/id"
        },
        "policyHash": {
          "$ref": "#/$defs/sha256"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "testId",
              "metric",
              "operator",
              "rationale",
              "minimumSampleSize"
            ],
            "properties": {
              "testId": {
                "$ref": "#/$defs/id"
              },
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "enum": [
                  "gte",
                  "lte",
                  "between",
                  "review_only"
                ]
              },
              "value": {
                "type": "number"
              },
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "minimumSampleSize": {
                "type": "integer",
                "minimum": 1
              },
              "confidenceDecision": {
                "enum": [
                  "point_estimate",
                  "conservative_interval",
                  "human_review"
                ]
              },
              "multipleComparisonPolicy": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "operator": {
                      "enum": [
                        "gte",
                        "lte"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "value"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "operator": {
                      "const": "between"
                    }
                  }
                },
                "then": {
                  "required": [
                    "lower",
                    "upper"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "thresholdRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "value"
      ],
      "properties": {
        "operator": {
          "enum": [
            "<=",
            ">="
          ]
        },
        "value": {
          "type": "number"
        },
        "policyId": {
          "type": "string"
        },
        "policyVersion": {
          "type": "string"
        },
        "source": {
          "const": "internal_policy"
        }
      }
    },
    "engineThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "policyVersion",
        "source",
        "values"
      ],
      "properties": {
        "policyId": {
          "type": "string",
          "minLength": 1
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "const": "internal_policy"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operator",
              "value"
            ],
            "properties": {
              "operator": {
                "enum": [
                  "<=",
                  ">="
                ]
              },
              "value": {
                "type": "number"
              }
            }
          }
        },
        "frozenAt": {
          "type": "string",
          "format": "date-time"
        },
        "approvedBy": {
          "$ref": "#/$defs/id"
        },
        "policyHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "interactiveThresholds": {
      "type": "object",
      "description": "Prototype calculator settings; production approval/provenance is a separate gate.",
      "required": [
        "minimumAccuracy",
        "maximumParityGap",
        "minimumImpactRatio",
        "source",
        "policyId",
        "policyVersion",
        "frozenAt",
        "frozenBy"
      ],
      "properties": {
        "minimumAccuracy": null,
        "maximumParityGap": null,
        "minimumImpactRatio": null,
        "minimumGroupSize": null,
        "source": {
          "const": "internal_policy"
        },
        "policyId": {
          "type": "string",
          "minLength": 1
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "frozenAt": {
          "type": "string",
          "format": "date-time"
        },
        "frozenBy": null
      }
    },
    "productionMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testId",
        "name",
        "value",
        "unit",
        "sampleSize",
        "outcome",
        "slice",
        "limitations"
      ],
      "properties": {
        "testId": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "numerator": {
          "type": [
            "number",
            "null"
          ]
        },
        "denominator": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "sampleSize": {
          "type": "integer",
          "minimum": 0
        },
        "missingCount": {
          "type": "integer",
          "minimum": 0
        },
        "confidenceInterval": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "lower",
            "upper",
            "level",
            "method"
          ],
          "properties": {
            "lower": {
              "type": "number"
            },
            "upper": {
              "type": "number"
            },
            "level": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "pValue": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "effectSize": {
          "type": [
            "number",
            "null"
          ]
        },
        "slice": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "description": "Minimized/pseudonymized labels. Avoid exposing small sensitive groups in client exports."
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "referenceGroup": {
              "type": "string"
            },
            "comparedGroup": {
              "type": "string"
            },
            "referenceValue": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "inconclusive",
            "not_applicable"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifactIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "const": null
              }
            }
          },
          "then": {
            "properties": {

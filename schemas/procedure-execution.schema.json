{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-assurance:procedure-execution:1.0",
  "title": "Actual audit procedure execution",
  "description": "Common human execution record bound to exact scope, program and procedure revisions. The server separately enforces authorization, evidence custody, completed-run bindings and independent review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","revision","briefRevision","programRevision","procedureRevision","performed","steps","sampling","results","limitations","evidenceIds","runIds","actor","at"],
  "$defs": {
    "id": {"type":"string","minLength":1,"maxLength":300},
    "revision": {"type":"integer","minimum":1},
    "text": {"type":"string","minLength":1,"maxLength":8000,"pattern":"\\S"},
    "ids": {"type":"array","items":{"$ref":"#/$defs/id"},"maxItems":100,"uniqueItems":true}
  },
  "properties": {
    "id":{"$ref":"#/$defs/id"},
    "revision":{"$ref":"#/$defs/revision"},
    "briefRevision":{"$ref":"#/$defs/revision"},
    "programRevision":{"$ref":"#/$defs/revision"},
    "procedureRevision":{"$ref":"#/$defs/revision"},
    "performed":{"$ref":"#/$defs/text"},
    "sampling":{"$ref":"#/$defs/text"},
    "results":{"$ref":"#/$defs/text"},
    "limitations":{"type":"string","maxLength":8000},
    "actor":{"$ref":"#/$defs/id"},
    "at":{"type":"string","format":"date-time"},
    "evidenceIds":{"allOf":[{"$ref":"#/$defs/ids"},{"minItems":1}]},
    "runIds":{"allOf":[{"$ref":"#/$defs/ids"},{"maxItems":30}]},
    "steps":{
      "type":"array","minItems":1,"maxItems":30,
      "items":{
        "type":"object","additionalProperties":false,"required":["id","state","notes"],
        "properties":{"id":{"$ref":"#/$defs/id"},"state":{"enum":["performed","not_performed"]},"notes":{"type":"string","maxLength":8000}},
        "if":{"properties":{"state":{"const":"not_performed"}}},
        "then":{"properties":{"notes":{"$ref":"#/$defs/text"}}}
      }
    },
    "assessment":{
      "type":"object","additionalProperties":false,
      "required":["relevance","reliability","coverage","contradictions","conclusion","outcome","actor","at"],
      "properties":{
        "relevance":{"$ref":"#/$defs/text"},"reliability":{"$ref":"#/$defs/text"},"coverage":{"$ref":"#/$defs/text"},"contradictions":{"$ref":"#/$defs/text"},"conclusion":{"$ref":"#/$defs/text"},
        "outcome":{"enum":["supported","qualified","not_supported"]},"actor":{"$ref":"#/$defs/id"},"at":{"type":"string","format":"date-time"}
      }
    },
    "impactReview":{
      "type":"object","additionalProperties":false,"required":["briefRevision","programRevision","actor","at","reason"],
      "properties":{"briefRevision":{"$ref":"#/$defs/revision"},"programRevision":{"$ref":"#/$defs/revision"},"actor":{"$ref":"#/$defs/id"},"at":{"type":"string","format":"date-time"},"reason":{"$ref":"#/$defs/text"}}
    }
  }
}

# Example settings for a self-hosted AI Assurance workspace.
#
# Every line is commented out, so the defaults apply. You do not need any of
# these settings to get started. Each one is explained in
# docs/self-hosting/configuration.md.
#
# This file has two parts, and they are used in different ways.
# It contains no secrets. Never add one: the app creates its only secret,
# DOSSIER_KEK, by itself on first start, in the secrets.env file of the data
# folder.

# ---------------------------------------------------------------------------
# Part 1: start-script variables (PORT, HOST, DATA_DIR)
#
# These are ordinary environment variables of the start script.
# Node.js: copy this file to .env (git ignores it), remove the "#" in front
# of the lines you want, then run in site-app/:
#     node --env-file=../.env scripts/self-host.mjs
# or set them on the command line: PORT=3000 npm run self-host
# Docker: the image sets all three already. To use another port on your
# machine, change the left number of "ports" in docker-compose.yml.
# ---------------------------------------------------------------------------

# The port the app listens on. Default: 8787.
#PORT=8787

# The address the app listens on. Default: 127.0.0.1 (this machine only).
# The Docker image sets 0.0.0.0.
#HOST=127.0.0.1

# The folder for the database, the evidence files and secrets.env.
# Default: ./data, which is site-app/data. The Docker image sets /data.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Part 2: app variables
#
# The app reads these only from the file secrets.env in the data folder
# (site-app/data/secrets.env under Node.js, /data/secrets.env under Docker).
# Setting them here, or as ordinary environment variables, has NO effect.
# Copy the lines you want into that file, remove the "#", and restart the app.
# Keep the DOSSIER_KEK line of that file exactly as it is.
# ---------------------------------------------------------------------------

# How people sign in. Unset means the built-in accounts (email and password).
# Set cloudflare-access only if the app runs behind Cloudflare Access.
#IDENTITY_MODE=local

# Needed only with IDENTITY_MODE=cloudflare-access.
#CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
#CF_ACCESS_AUD=your-access-application-audience-tag

# For automated tests only, with IDENTITY_MODE=trusted-headers.
# Never set it on a real installation.
#IDENTITY_TRUSTED_HEADERS=loopback-tests

# Who may create a practice without an invitation: off, open, or a list of
# email addresses and @domains separated by commas. Unset means off.
#SELF_SIGNUP=off
#SELF_SIGNUP=owner@example.com,@example.com

# The most engagements one practice may hold. Default: 200.
#TENANT_MAX_ENGAGEMENTS=200

# The most engagement versions one practice may save in an hour. Default: 1000.
#TENANT_MAX_SAVES_PER_HOUR=1000

# Exact email addresses, separated by commas, of the people who may open
# /operator. Unset means nobody.
#PLATFORM_OPERATORS=operator@example.com
